{
  "name": "@luixo/configs",
  "version": "0.0.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luixo/configs.git"
  },
  "files": [
    "dist/**"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "exports": {
    "types": "./dist/index.d.mts",
    "default": "./dist/index.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "bun check",
    "build": "tsdown --dts index.ts",
    "check:package": "publint && attw --pack . --profile esm-only",
    "release": "npm run build && changeset publish",
    "format": "oxfmt --write",
    "format:verify": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint-staged": "lint-staged"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/bun": "1.4.3",
    "lint-staged": "^15.2.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "pre-commit": "^1.2.2",
    "publint": "^0.3.25",
    "tsdown": "^0.23.1"
  },
  "peerDependencies": {
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,astro}": [
      "oxfmt --write",
      "oxlint --fix"
    ],
    "*.{json,jsonc,css,md,mdx,yml,yaml}": [
      "oxfmt --write"
    ]
  },
  "pre-commit": [
    "typecheck",
    "lint-staged"
  ],
  "engines": {
    "node": "26"
  },
  "packageManager": "bun@1.4.3"
}

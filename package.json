{
  "name": "@luixo/configs",
  "version": "0.0.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luixo/configs.git"
  },
  "files": [
    "dist/**"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "exports": {
    "types": "./dist/index.d.mts",
    "default": "./dist/index.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "bun check",
    "build": "tsdown --dts index.ts",
    "check:package": "publint && attw --pack . --profile esm-only",
    "release": "npm run build && changeset publish",
    "format": "oxfmt --write",
    "format:verify": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@types/bun": "1.4.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "publint": "^0.3.25",
    "tsdown": "^0.23.1"
  },
  "peerDependencies": {
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0"
  },
  "engines": {
    "node": "26"
  },
  "packageManager": "bun@1.4.3"
}

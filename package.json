{
	"name": "@luixo/configs",
	"version": "0.2.0",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/luixo/configs.git"
	},
	"files": [
		"dist/**"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"exports": {
		"types": "./dist/index.d.mts",
		"default": "./dist/index.mjs"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsdown",
		"changeset": "changeset add",
		"deps": "knip",
		"format": "oxfmt --write",
		"format:verify": "oxfmt --check",
		"lint": "oxlint",
		"lint-staged": "lint-staged",
		"lint:fix": "oxlint --fix",
		"typecheck": "bun check"
	},
	"dependencies": {
		"oxlint-plugin-eslint": "^1.88.0"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@tanstack/eslint-plugin-router": "^1.162.0",
		"@types/bun": "1.4.3",
		"eslint-plugin-better-tailwindcss": "^4.9.1",
		"eslint-plugin-package-json": "^1.10.1",
		"eslint-plugin-playwright": "^2.12.1",
		"knip": "^6.42.0",
		"lint-staged": "^15.2.2",
		"oxfmt": "^0.73.0",
		"oxlint": "^1.88.0",
		"oxlint-tsgolint": "^7.0.2004",
		"pre-commit": "^1.2.2",
		"publint": "^0.3.25",
		"remeda": "^2.52.0",
		"tsdown": "^0.23.1"
	},
	"peerDependencies": {
		"knip": "^6.42.0",
		"oxfmt": "^0.73.0",
		"oxlint": "^1.88.0"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx}": [
			"oxlint"
		]
	},
	"pre-commit": [
		"typecheck",
		"format",
		"lint-staged"
	],
	"engines": {
		"node": "26"
	},
	"packageManager": "bun@1.4.3"
}
